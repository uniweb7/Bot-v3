    if not os.path.exists(CUSTOM_PRESET_FILE):
        return default_preset
    try:
        with open(CUSTOM_PRESET_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
            if isinstance(data, dict):
                default_preset.update(data)
    except Exception:
        pass
    return default_preset

def save_custom_preset(preset_data):
    try:
        with open(CUSTOM_PRESET_FILE, "w", encoding="utf-8") as f:
            json.dump(preset_data, f, indent=2, ensure_ascii=False)
    except Exception:
        pass

def configure_custom_mode_9():
    """
    Option [9] -> Create Options (Manual Custom Mode Builder + Saved Preset #S5):
    Allows the user to manually combine:
      - 1 + 3 (Fast Attack + ID Switching)
      - 1 + 2 (Fast Attack + Fast Upgrading)
      - 1 + 2 + 3 (Fast Attack + Fast Upgrading + ID Switching)
