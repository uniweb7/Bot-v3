def _invalidate_screen_cache():
    _SCREENSHOT_CACHE["img"] = None
    _SCREENSHOT_CACHE["timestamp"] = 0.0

def reset_persistent_adb_shell():
    """Point #L28: Cleanly closes and refreshes the persistent ADB shell pipe every Master Cycle."""
    global _ADB_SHELL_PROC
    with _ADB_LOCK:
        if _ADB_SHELL_PROC is not None:
            try:
                _ADB_SHELL_PROC.stdin.close()
            except Exception:
                pass
            try:
                _ADB_SHELL_PROC.terminate()
            except Exception:
                pass
            _ADB_SHELL_PROC = None

def _exec_adb_shell_cmd(cmd_str):
    """
    Point #38 & #L27: Sends input tap/swipe commands through a persistent open 'adb shell' pipe
    for near-zero latency, with timeout-protected fallback so it never hangs overnight.
    """
    global _ADB_SHELL_PROC
    _invalidate_screen_cache()
    with _ADB_LOCK:
        try:
            if _ADB_SHELL_PROC is None or _ADB_SHELL_PROC.poll() is not None:
                _ADB_SHELL_PROC = subprocess.Popen(
                    ["adb", "shell"],
                    stdin=subprocess.PIPE,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    text=True,
                    bufsize=1
                )
            _ADB_SHELL_PROC.stdin.write(cmd_str + "\n")
            _ADB_SHELL_PROC.stdin.flush()
            return
        except Exception:
            _ADB_SHELL_PROC = None
    try:
        subprocess.run(["adb", "shell", cmd_str], timeout=5)
    except Exception:
        pass

def human_sleep(base_sec, variance=0.04, apply_speed=True, min_floor=0.06):
    check_pause_point(allow_raise=True)
    raw_t = max(0.015, float(base_sec) + random.uniform(-variance, variance))
    smart_sleep(raw_t, apply_speed=apply_speed, min_floor=min_floor)

def tap(x, y, delay_range=(0.03, 0.07), jitter=2, check_pause=True, apply_speed=True):
    if check_pause:
        check_pause_point(allow_raise=True)
    jx = int(x) + random.randint(-jitter, jitter)
    jy = int(y) + random.randint(-jitter, jitter)
    _exec_adb_shell_cmd(f"input tap {jx} {jy}")
    if delay_range and delay_range[1] > 0:
        wait_t = random.uniform(*delay_range)
        if apply_speed:
            wait_t = scale_time_by_speed(wait_t, min_floor=0.02)
        if check_pause:
            smart_sleep(wait_t, apply_speed=False)
        else:
            time.sleep(wait_t)

def fast_serial_taps(coord_list, rounds=1, jitter=2):
    """
    Executes multiple rounds of taps in exact serial order inside a SINGLE adb shell command
    so 2 rounds of Spells or 4 rounds of Army 1 finish within ~0.6s with 100% accuracy & anti-ban jitter.
    """
    check_pause_point(allow_raise=True)
    cmds = []
    for _ in range(rounds):
        for (x, y) in coord_list:
            jx = int(x) + random.randint(-jitter, jitter)
            jy = int(y) + random.randint(-jitter, jitter)
            cmds.append(f"input tap {jx} {jy}")
    if cmds:
        _exec_adb_shell_cmd("; ".join(cmds))

def batch_tap_sequence(coord_list, inter_delay=0.04, jitter=2):
    """
    Point #1, #47 & #T11: Sends a batch of taps in a single ADB shell line with minimal post-batch overhead (0.04s).
    """
    check_pause_point(allow_raise=True)
    cmds = []
    scaled_gap = scale_time_by_speed(inter_delay, min_floor=0.02) if inter_delay > 0 else 0.0
    for idx, (x, y) in enumerate(coord_list):
        jx = int(x) + random.randint(-jitter, jitter)
        jy = int(y) + random.randint(-jitter, jitter)
        cmds.append(f"input tap {jx} {jy}")
        if scaled_gap >= 0.08 and idx < len(coord_list) - 1:
            cmds.append(f"sleep {scaled_gap:.2f}")
    if cmds:
        _exec_adb_shell_cmd("; ".join(cmds))
    if 0 < scaled_gap < 0.08:
        smart_sleep(0.04, apply_speed=False)

def swipe(x1, y1, x2, y2, duration=300, post_sleep=0.32, apply_speed=True):
    """Point #14 & Order #3: Speed-scaled swipe with safe 160ms hardware floor."""
    check_pause_point(allow_raise=True)
    sx1 = int(x1) + random.randint(-4, 4)
    sy1 = int(y1) + random.randint(-4, 4)
    sx2 = int(x2) + random.randint(-4, 4)
    sy2 = int(y2) + random.randint(-4, 4)
    if apply_speed:
        scaled_dur = int(max(160, scale_time_by_speed(duration, min_floor=160) + random.randint(-15, 20)))
    else:
        scaled_dur = int(max(180, duration + random.randint(-15, 20)))
    _exec_adb_shell_cmd(f"input swipe {sx1} {sy1} {sx2} {sy2} {scaled_dur}")
    human_sleep(post_sleep, 0.04, apply_speed=apply_speed, min_floor=0.08)

def get_screenshot(check_pause=True, force_fresh=False):
    """
    Point #37, #T15 & #L27:
    - In-Memory RAM Screenshot using io.BytesIO (zero disk wear, ~4MB fixed RAM).
    - Point #T15: 0.28s micro-cache when no tap/swipe occurred in between.
    - Point #L27: Strict timeout=6 on fallback screencap so ADB can NEVER freeze overnight!
    """
    if check_pause:
        check_pause_point(allow_raise=True)

    now = time.time()
    if (not force_fresh) and (_SCREENSHOT_CACHE["img"] is not None) and ((now - _SCREENSHOT_CACHE["timestamp"]) <= 0.28):
        return _SCREENSHOT_CACHE["img"]

    img = None
    try:
        proc = subprocess.run(
            ["adb", "exec-out", "screencap", "-p"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=6
        )
        if proc.returncode == 0 and proc.stdout and len(proc.stdout) > 1024:
            bio = io.BytesIO(proc.stdout)
            loaded_img = Image.open(bio)
            loaded_img.load()
            img = loaded_img.convert("RGB")
            bio.close()
    except Exception:
        img = None

    if img is None:
        try:
            subprocess.run("adb exec-out screencap -p > screen.png", shell=True, timeout=6)
            if os.path.exists("screen.png"):
                img = Image.open("screen.png").convert("RGB")
        except Exception:
            reset_persistent_adb_shell()
            if _SCREENSHOT_CACHE["img"] is not None:
                return _SCREENSHOT_CACHE["img"]
            img = Image.new("RGB", (2400, 1080), (0, 0, 0))

    _SCREENSHOT_CACHE["img"] = img
    _SCREENSHOT_CACHE["timestamp"] = time.time()
    return img

def clean_ram_garbage():
    """Point #50 & #L28: Periodic RAM garbage collection + ADB shell pipe refresh."""
    _invalidate_screen_cache()
    reset_persistent_adb_shell()
    gc.collect()

