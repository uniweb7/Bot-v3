def _keyboard_listener_worker():
    """
    Background thread that watches Termux keyboard input continuously.
    Typing 'zx' pauses the bot immediately and prints PREVIOUS PROGRESS REPORT.
    Typing 'qw' resumes the bot from Home Page at the exact same speed & session report.
    """
    try:
        import termios
        import tty
        fd = sys.stdin.fileno()
        old_settings = termios.tcgetattr(fd)
        tty.setcbreak(fd)
        use_cbreak = True
    except Exception:
        use_cbreak = False

    try:
        while True:
            if use_cbreak:
                rlist, _, _ = select.select([sys.stdin], [], [], 0.15)
                if rlist:
                    ch = sys.stdin.read(1)
                    if not ch:
                        time.sleep(0.1)
                        continue
                    do_pause = False
                    do_resume = False
                    with _PAUSE_LOCK:
                        _PAUSE_STATE["buffer"] = (_PAUSE_STATE["buffer"] + ch.lower())[-12:]
                        buf = _PAUSE_STATE["buffer"]
                        if not _PAUSE_STATE["paused"] and "zx" in buf:
                            _PAUSE_STATE["paused"] = True
                            _PAUSE_STATE["buffer"] = ""
                            do_pause = True
                        elif _PAUSE_STATE["paused"] and "qw" in buf:
                            _PAUSE_STATE["paused"] = False
                            _PAUSE_STATE["resumed_just_now"] = True
                            _PAUSE_STATE["buffer"] = ""
                            do_resume = True
                    if do_pause:
                        _trigger_pause_state()
                    elif do_resume:
                        _trigger_resume_state()
            else:
                line = sys.stdin.readline()
                if not line:
                    time.sleep(0.2)
                    continue
                clean_line = line.strip().lower()
                do_pause = False
                do_resume = False
                with _PAUSE_LOCK:
                    if not _PAUSE_STATE["paused"] and "zx" in clean_line:
                        _PAUSE_STATE["paused"] = True
                        do_pause = True
                    elif _PAUSE_STATE["paused"] and "qw" in clean_line:
                        _PAUSE_STATE["paused"] = False
                        _PAUSE_STATE["resumed_just_now"] = True
                        do_resume = True
                if do_pause:
                    _trigger_pause_state()
                elif do_resume:
                    _trigger_resume_state()
    except Exception:
        pass
    finally:
        if use_cbreak:
            try:
                termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
            except Exception:
                pass

def start_pause_resume_listener():
    with _PAUSE_LOCK:
        if _PAUSE_STATE["listener_started"]:
            return
        _PAUSE_STATE["listener_started"] = True
    t = threading.Thread(target=_keyboard_listener_worker, daemon=True)
    t.start()

def check_pause_point(allow_raise=True):
    was_paused = False
    while True:
        with _PAUSE_LOCK:
            is_paused = _PAUSE_STATE["paused"]
            resumed_flag = _PAUSE_STATE["resumed_just_now"]
        if is_paused:
            was_paused = True
            time.sleep(0.20)
            continue
        if was_paused or resumed_flag:
            with _PAUSE_LOCK:
                _PAUSE_STATE["resumed_just_now"] = False
            if allow_raise:
                raise BotPausedResumeHomeException("Resumed via QW -> Resetting to Home Page")
        break

def smart_sleep(seconds, apply_speed=True, min_floor=0.06):
    """
    Order #3: Root-level speed-scaled sleep!
    By default apply_speed=True so all standard bot waits automatically scale with BOT_SPEED_MULTIPLIER,
    while fixed game timers (45s battle timer, 600s maintenance, etc.) pass apply_speed=False.
    """
    raw_sec = max(0.0, float(seconds))
    if raw_sec <= 0.0:
        check_pause_point(allow_raise=True)
        return
    dur = scale_time_by_speed(raw_sec, min_floor=min_floor) if apply_speed else raw_sec
    end_time = time.time() + dur
    while time.time() < end_time:
        check_pause_point(allow_raise=True)
        rem = end_time - time.time()
        if rem <= 0:
            break
        time.sleep(min(0.18, rem))
