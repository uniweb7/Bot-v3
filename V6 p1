def has_enough_ink_pixels(bw_img, min_black_px=8):
    """Point #42 & #T14: Fast pre-check to skip Tesseract if a thresholded crop is blank white."""
    w, h = bw_img.size
    px = bw_img.load()
    black_cnt = 0
    for y in range(0, h, 2):
        for x in range(0, w, 2):
            if px[x, y] == 0:
                black_cnt += 1
                if black_cnt >= min_black_px:
                    return True
    return False

def trim_binary_horizontal_whitespace(bw_img, extra_pad=8):
    """Point #46: Trims trailing blank white space on wide text crops while preserving 100% letter accuracy."""
    inv = ImageOps.invert(bw_img)
    bbox = inv.getbbox()
    if not bbox:
        return bw_img
    left, top, right, bottom = bbox
    w, h = bw_img.size
    c_left = max(0, left - extra_pad)
    c_right = min(w, right + extra_pad)
    return bw_img.crop((c_left, 0, c_right, h))

def parse_builder_fraction(raw_text):
    """
    Point #L5 & #L16:
    Carefully parses 'Available / Total' builders where Total Builders can be 5, 6, 7, 8, 9, or 10
    and Available Builders can be 0 up to 10 (e.g., '0/6', '1/6', '4/7', '6/8', '1/76' OCR slash noise, etc.).
    """
    if not raw_text:
        return None
    s = raw_text.strip().replace(" ", "")
    # Normalize common OCR slash/one confusions at the start
    s = re.sub(r'^[|Il!i](?=/\d)', '1', s)
    s = re.sub(r'(?<=\d)[|Il!i](?=[56789]\b|10\b)', '/', s)

    if '/' in s:
        parts = s.split('/', 1)
        left = parts[0].strip()
        left = re.sub(r'[|Il!i]', '1', left)
        if not left:
            return None
        digits = re.sub(r'[^0-9]', '', left)
        if digits:
            if digits.endswith("10"):
                return 10
            val = int(digits[-1])
            if 0 <= val <= 10:
                return val
        return None

    digits_only = re.sub(r'[^0-9]', '', s)
    # Handle cases where '/' was read as '1' or '7' before total builders (5..9 or 10)
    if len(digits_only) == 3 and digits_only[1] in ['1', '7'] and digits_only[2] in ['5', '6', '7', '8', '9']:
        return int(digits_only[0])
    if len(digits_only) == 2 and digits_only[1] in ['5', '6', '7', '8', '9']:
        return int(digits_only[0])
    return None

def read_builder_check_box_a14(img=None):
    """
    Point #3, #T14, #L5 & #L16:
    3x BILINEAR zoom + ink pre-check + multi-threshold OCR + Left-Crop fallback supporting up to 10 builders.
    """
    global LAST_DETECTED_BUILDERS, LAST_BUILDER_CHECK_TIME
    if img is None:
        img = get_screenshot()
    x1, y1, x2, y2 = UPGRADE_A14["BUILDER_CHECK_BOX"]
    w = x2 - x1
    crop = img.crop((x1 - 2, y1 - 2, x2 + 2, y2 + 2))
    large = crop.resize((crop.width * 3, crop.height * 3), Image.Resampling.BILINEAR).convert('L')
    cfg = '--oem 3 --psm 7 -c load_system_dawg=0 -c load_freq_dawg=0 -c tessedit_char_whitelist=0123456789/|Il!'

    for thresh in [180, 168, 192]:
        bw = large.point(lambda p: 0 if p > thresh else 255, '1').convert('L')
        # Point #T14: Skip Tesseract if threshold produced blank image
        if not has_enough_ink_pixels(bw, min_black_px=5):
            continue
        padded = ImageOps.expand(bw, border=10, fill=255)
        txt = pytesseract.image_to_string(padded, config=cfg).strip()
