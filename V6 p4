    print(f"\n [✔] Selected Mode: [{choice}] -> {mode_names[choice]} | Speed: {get_bot_speed_multiplier():.2f}x")

    total_ids = 1
    start_id_index = 1
    mode8_attacks_per_id = 5

    if choice in ["4", "5", "6", "8"]:
        mem = load_id_memory()
        default_total = mem.get("total_ids", 10)
