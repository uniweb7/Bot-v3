            print(" [0.6s] Checking Home Page, Clan Chat Drawer & clicking Gold Storage 3x...")
            smart_sleep(0.60, apply_speed=True)
            check_wrong_buttons_a14(check_clan_chat=True)
            click_gold_storage_3_times()

            # 2. Point #T22: Matchmaking (0.20s -> Battle -> 0.35s -> Find Match -> 0.65s -> Attack) with zero double delay
            print(" [0.20s] Clicking Battle Button (182, 961)...")
            smart_sleep(0.20, apply_speed=True)
            tap(*FAST_ATTACK["BATTLE_BTN"], delay_range=(0.0, 0.0), jitter=3)

            print(" [0.35s] Waiting 0.35s -> Clicking Find Match (364, 808)...")
            smart_sleep(0.35, apply_speed=True)
            tap(*FAST_ATTACK["FIND_MATCH_BTN"], delay_range=(0.0, 0.0), jitter=3)

            print(" [0.65s] Waiting 0.65s -> Clicking Attack Button (1980, 972)...")
            smart_sleep(0.65, apply_speed=True)
            tap(*FAST_ATTACK["ATTACK_BTN"], delay_range=(0.0, 0.0), jitter=3)

            # 3. Point #28, #T1, #T2 & #L20: Smart Enemy Base Load
            loaded_early = wait_for_enemy_base_load_smart(max_wait_sec=18.0)
            if not loaded_early:
                # Point #T1: Only run post-18s scan if base wasn't already confirmed early
                scan_battlefield_or_restart("Post-18s Base Load Check")

            # ==================================================================
            # 4 TO 8. 7-SECOND FULL DEPLOYMENT ENGINE (#T23 Modified + #T24)
            # Completes Spell Select -> 2x Spells -> 4x Army 1 -> 2x Army 2 ->
            # Siege & Heroes 1-4 -> All 4 Hero Abilities within ~5.8s - 6.6s (< 7s)
            # with 100% coordinate, round, and sequence accuracy!
            # ==================================================================

            # 4. Spell Select (1527, 983) -> 2 Rounds Deploy (Starts 45s Battle Timer)
            print(" [DEPLOY STEP 4] Selecting Spell (1527, 983) & deploying 2 Rounds...")
            tap(*FAST_ATTACK["SPELL_SELECT"], delay_range=(0.03, 0.05), jitter=2)
            spell_select_timer = time.time()
            smart_sleep(0.10, apply_speed=True, min_floor=0.05)
            fast_serial_taps(FAST_ATTACK["SPELL_DEPLOY_LIST"], rounds=2, jitter=3)

            # 5. Point #T23: Army 1 Select (470, 988) after 0.12s -> 4 Rounds Deploy
            print(" [DEPLOY STEP 5] Selecting Army 1 (470, 988) & deploying 4 Rounds in Serial Order...")
            smart_sleep(0.12, apply_speed=True, min_floor=0.06)
            tap(*FAST_ATTACK["ARMY_1_SELECT"], delay_range=(0.03, 0.05), jitter=2)
            smart_sleep(0.06, apply_speed=True, min_floor=0.04)
            fast_serial_taps(FAST_ATTACK["ARMY_1_DEPLOY_LIST"], rounds=4, jitter=3)

            # 6. Point #T23: Army 2 Select (590, 985) after 0.12s -> 2 Rounds Deploy
            print(" [DEPLOY STEP 6] Selecting Army 2 (590, 985) & deploying 2 Rounds on 3 Coords...")
            smart_sleep(0.12, apply_speed=True, min_floor=0.06)
            tap(*FAST_ATTACK["ARMY_2_SELECT"], delay_range=(0.03, 0.05), jitter=2)
            smart_sleep(0.08, apply_speed=True, min_floor=0.04)
            fast_serial_taps(FAST_ATTACK["ARMY_2_DEPLOY_LIST"], rounds=2, jitter=3)

            # 7. Point #30: Siege Machine + Heroes 1-4 (1 Round each on Army 1 Coords)
            print(" [DEPLOY STEP 7] Deploying Siege Machine & Heroes 1-4 (1 Round each on Army 1 Coords)...")
            siege_and_heroes = [
                ("Siege Machine", FAST_ATTACK["SIEGE_SELECT"]),
                ("Hero 1", FAST_ATTACK["HERO_1_SELECT"]),
                ("Hero 2", FAST_ATTACK["HERO_2_SELECT"]),
                ("Hero 3", FAST_ATTACK["HERO_3_SELECT"]),
                ("Hero 4", FAST_ATTACK["HERO_4_SELECT"])
            ]
            for unit_name, select_coord in siege_and_heroes:
                check_pause_point(allow_raise=True)
                tap(*select_coord, delay_range=(0.04, 0.06), jitter=2)
                fast_serial_taps(FAST_ATTACK["ARMY_1_DEPLOY_LIST"], rounds=1, jitter=3)
                smart_sleep(0.04, apply_speed=True, min_floor=0.02)

            # 8. Point #T23 (7s Target) & #T24 (Batch Hero Abilities Activation)
            # Dynamic wait so total time from Spell Select to Hero 4 Ability finishes cleanly in ~6.2s - 6.8s (<= 7.0s)!
            elapsed_so_far = time.time() - spell_select_timer
            ability_pre_wait = max(0.80, min(1.55, 6.35 - elapsed_so_far))
            print(f" [{ability_pre_wait:.2f}s] Activating Hero 1, 2, 3, 4 Abilities in Single Batch (#T24)...")
            smart_sleep(ability_pre_wait, apply_speed=True, min_floor=0.50)

            batch_tap_sequence([
                FAST_ATTACK["HERO_1_SELECT"],
                FAST_ATTACK["HERO_2_SELECT"],
                FAST_ATTACK["HERO_3_SELECT"],
                FAST_ATTACK["HERO_4_SELECT"]
            ], inter_delay=0.05, jitter=2)

            elapsed_deploy = time.time() - spell_select_timer
            print(f" [⚡ 7s DEPLOY ENGINE] Full Spells + Army 1/2 + Siege/Heroes + Abilities completed in {elapsed_deploy:.2f}s (<= 7.0s)!")

            # Point #T3 & #L22: Single screenshot check after Hero Abilities for Early Victory OR Wrong/Home status
            post_ability_img = get_screenshot(force_fresh=True)
            battle_ended_early = False
            if is_return_home_victory_button_visible_a14(post_ability_img):
                print(f" [✔] [INSTANT VICTORY #L22] Return Home button (1222, 918) already visible at {elapsed_deploy:.1f}s!")
                battle_ended_early = True
            else:
                scan_battlefield_or_restart("Post-Hero-4-Ability Check", img=post_ability_img)

            # 9. Point #4 (45s Battle Timer) + Point #29 (Early 100% Victory Return Home Detector)
            while not battle_ended_early:
                check_pause_point(allow_raise=True)
                elapsed_since_spell = time.time() - spell_select_timer
                rem_wait = BATTLE_TIMER_DURATION_SEC - elapsed_since_spell
                if rem_wait <= 0:
                    break

                if elapsed_since_spell >= 20.0:
                    b_img = get_screenshot(force_fresh=True)
                    if is_return_home_victory_button_visible_a14(b_img):
                        print(f" [✔] [EARLY BATTLE END #29] Return Home button (1222, 918) detected at {elapsed_since_spell:.1f}s! Skipping Surrender...")
                        battle_ended_early = True
                        break
                    chunk = min(2.5, rem_wait)
                    print(f" [45s TIMER] {rem_wait:.1f}s remaining in 45s Battle Timer...")
                    smart_sleep(chunk, apply_speed=False)
                else:
                    wait_to_20 = min(rem_wait, max(0.5, 20.0 - elapsed_since_spell))
                    print(f" [45s TIMER] Waiting {rem_wait:.1f}s to complete 45s Battle Timer from Spell Select...")
                    smart_sleep(wait_to_20, apply_speed=False)

            # 10. Point #8, #T4, #T25 & #L23: Surrender -> Okay -> Return Home -> Dynamic Home Green '+' Check
            if not battle_ended_early:
                print(" [SURRENDER] Clicking Surrender Button (181, 800) 3 times...")
                batch_tap_sequence([FAST_ATTACK["SURRENDER_BTN"]] * 3, inter_delay=0.08, jitter=3)

                print(" [0.6s] Waiting 0.6s -> Clicking Okay Button (1419, 701)...")
                smart_sleep(0.60, apply_speed=False)
                tap(*FAST_ATTACK["OKAY_BTN"], delay_range=(0.08, 0.14), jitter=3, apply_speed=False)

                print(" [1.1s] Waiting 1.1s before Return Home...")
                smart_sleep(1.10, apply_speed=False)
                # Point #T25: Redundant Star-Screen Pre-Return-Home screenshot removed!

            print(" [RETURN] Clicking Return Home Button (1222, 918) 3 times...")
            batch_tap_sequence([FAST_ATTACK["RETURN_HOME_BTN"]] * 3, inter_delay=0.08, jitter=3)

            # Point #T4 & #L23: Dynamic Home Page Green '+' detection starting at 0.45s + Victory Screen Re-Tap Guard
            print(" [SMART HOME SETTLE #T4] Checking Home Page arrival (0.45s dynamic check)...")
            smart_sleep(0.45, apply_speed=False)
            ret_img = get_screenshot(force_fresh=True)

            if not is_on_home_page_a14(ret_img):
                # Point #L23: If still on Victory screen (Return Home button visible), tap (1222, 918) again!
                if is_return_home_victory_button_visible_a14(ret_img):
                    print(" [!] [RETURN HOME RE-TAP #L23] Still on Victory screen! Clicking Return Home (1222, 918) again...")
                    batch_tap_sequence([FAST_ATTACK["RETURN_HOME_BTN"]] * 3, inter_delay=0.08, jitter=3)
                smart_sleep(0.65, apply_speed=False)
                ret_img = get_screenshot(force_fresh=True)

            check_wrong_and_home_page_a14(ret_img, check_clan_chat=True)

            # Order #4: Record successful attack in Previous Progress Report
            record_stat("attacks_success", 1)
            print(" [✔] [FAST ATTACK COMPLETE] Fast Attack Cycle Finished Successfully!\n")
            return True

        except BotPausedResumeHomeException:
            raise
        except RestartLoopException as re_err:
            # Point #T26 & Order #4: Record failed/restarted attack attempt and fast 0.30s retry
            record_stat("attacks_failed", 1)
            print(f"\n [RESTARTING ATTACK #T26] Attempt #{attempt}/3 failed ({re_err}). Retrying in 0.30s...")
            if attempt >= 2:
                # Point #L2: On 2nd failed attempt, run safe in-game Clan Chat / Modal recovery
                ensure_return_to_home_page_a14()
            else:
                smart_sleep(0.30, apply_speed=True)
            continue
        except Exception as e:
            record_stat("attacks_failed", 1)
            print("\n[! ERROR!] Fast Attack Loop me error aayi:")
            traceback.print_exc()
            return False

    # Point #L3: If all 3 attempts failed, run full 3-Step Home Page Recovery
    print(" [!] [3 ATTEMPTS FAILED #L3] Running 3-Step In-Game Home Recovery...")
    ensure_return_to_home_page_a14()
    return False
