def execute_attack(is_first_attack=True):
    for attempt in range(1, 4):
        try:
            check_pause_point(allow_raise=True)
            print("\n======================================================================")
            print(f" || [FAST ATTACK LOOP - 45s TIMER] - ATTEMPT #{attempt}/3 ||")
            print("======================================================================")

